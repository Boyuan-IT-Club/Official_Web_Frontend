# 生产：同源相对路径，请求 /api/* 由 nginx 反代到后端集群，避免跨域。
# 留空即可（axios baseURL 为空 -> 相对当前站点 origin）。
REACT_APP_API_URL=

# 协同评价表的 WebSocket。留空则自动推导为 wss://<当前域名>/collab，
# 由 nginx 反代到固定在 A 机的协同服务（该服务只能单实例，见 05-7 文档）。
REACT_APP_COLLAB_WS_URL=

# 客服 Agent 聊天通道。必须显式设为同源相对路径:组件里的兜底值是
# http://127.0.0.1:8001/api/agent/chat(本地开发用),生产留空会让访客的
# 浏览器去连它自己的 localhost:8001 —— 浮窗对所有真实用户都失败。
# 由 nginx 的 location /api/agent/ 反代到 A 机 agent 容器(SSE,单实例)。
REACT_APP_AGENT_URL=/api/agent/chat
