{
  "name": "club-offical-frontend",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hocuspocus/provider": "^4.6.0",
    "@reduxjs/toolkit": "^2.8.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "antd": "^5.27.0",
    "axios": "^1.11.0",
    "dayjs": "^1.11.13",
    "echarts": "^6.1.0",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "lucide-react": "^0.563.0",
    "mammoth": "^1.12.1",
    "normalize.css": "^8.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.7.1",
    "react-scripts": "5.0.1",
    "sass": "1.32.12",
    "web-vitals": "^2.1.4",
    "yjs": "^13.6.32"
  },
  "scripts": {
    "start": "craco start",
    "start:admin": "REACT_APP_MODE=admin REACT_APP_SITE_TITLE=博远社团管理后台 craco start",
    "build": "npm run build:user && npm run build:admin",
    "build:user": "REACT_APP_MODE=user BUILD_PATH=build-user craco build",
    "build:admin": "REACT_APP_MODE=admin REACT_APP_SITE_TITLE=博远社团管理后台 BUILD_PATH=build-admin craco build",
    "typecheck": "tsc --noEmit",
    "test": "craco test",
    "eject": "craco eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "jest": {
    "transformIgnorePatterns": [
      "[/\\\\]node_modules[/\\\\](?!(yjs|lib0|y-protocols)[/\\\\]).+\\.(js|jsx|mjs|cjs|ts|tsx)$",
      "^.+\\.module\\.(css|sass|scss)$"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@craco/craco": "^7.1.0",
    "@types/file-saver": "^2.0.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "typescript": "^4.9.5"
  }
}
