# 本地开发：直连后端（localhost:3000 已在后端 CORS 白名单内）
# 生产构建不使用本文件；生产走同源相对路径，由 nginx 反代 /api 到后端集群。
# 注：生产集群已迁移至腾讯云，8080 端口仅内网可达，本地开发直连域名入口。
REACT_APP_API_URL=https://official.boyuan.club
REACT_APP_SITE_TITLE=博远信息技术社 - 探索技术，创造未来


# 协同评价表的 WebSocket 地址。留空则按当前站点推导为 <当前域名>/collab，
# 但开发时页面跑在 localhost:3000、协同服务在别处，必须显式指定。
# 本地起 collab-server 时用 ws://localhost:3100；想连线上环境则改成 wss://official.boyuan.club/collab。
REACT_APP_COLLAB_WS_URL=ws://localhost:3100
# 客服 Agent 服务(INF-08):本地开发直连 agent FastAPI;生产走网关同源反代(留空)
REACT_APP_AGENT_URL=http://127.0.0.1:8001/api/agent/chat
